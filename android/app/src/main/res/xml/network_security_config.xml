<?xml version="1.0" encoding="utf-8"?>
<!--
  just_audio serves any audio source that has custom headers (our
  Authorization header on the audiobook and read-along streams) through a
  local proxy at http://127.0.0.1. Android blocks cleartext HTTP by default,
  which makes those players fail to load. Allow cleartext only for the
  on-device loopback address; everything else stays HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
